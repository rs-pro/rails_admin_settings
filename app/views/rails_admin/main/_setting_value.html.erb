<% if @object.type == 'boolean' %>
  <%= form.check_box :raw, {}, 'true', 'false' %>
<% elsif %w[string integer float phone email address url domain color].include?(@object.type) %>
  <%= form.text_field :raw, value: field.value %>
<% elsif %w[html sanitized sanitize].include?(@object.type) && form.respond_to?(:cktext_area) %>
  <%= form.cktext_area :raw, value: field.value, rows: 10, cols: 80 %>
<% else %>
  <%= form.text_area :raw, value: field.value, rows: 10, cols: 80 %>
<% end %>
